# --- Required ---
# Postgres connection string (on Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/captomundi
# Long random string: openssl rand -base64 32
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Photo storage (S3-compatible bucket, e.g. Railway Storage Bucket) ---
# Leave BUCKET_NAME empty in local development to store uploads on disk (./media).
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_ENDPOINT=
BUCKET_REGION=auto
# Set to "true" if your provider needs path-style URLs
BUCKET_FORCE_PATH_STYLE=false
